# Everything is optional. With nothing set, the app runs on demo data,
# writes a template brief, and records Slack posts as dry runs.

# --- LLM: Google Gemini (without a key, a template brief is written instead) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Notion: internal integration token + the tracker database ID ---
# Share the database with the integration (••• → Connections) or queries return 404.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional overrides when your column names differ, e.g. {"owner":"DRI","dueDate":"Ship Date"}
NOTION_PROPERTY_MAP=

# --- Slack: bot token (chat:write) preferred, or an incoming webhook ---
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#executive-updates

# --- Automation ---
# Cron for unattended runs; they auto-post only if every quality gate passes.
SCHEDULE_CRON=
SCHEDULE_TZ=UTC
MIN_CONFIDENCE=70
HIGH_RISK_LIMIT=2

# Require this token (x-admin-token header / UI field) to run or publish.
ADMIN_TOKEN=
PORT=3000

# Comma-separated services whose keys an outbound proxy injects (e.g. Claude Code
# cloud network secrets): notion,slack. Leave their tokens above empty.
PROXY_INJECTED_CREDENTIALS=
